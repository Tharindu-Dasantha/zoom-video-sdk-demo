# Zoom Video SDK credentials (for joining/recording sessions)
ZOOM_SDK_KEY=""
ZOOM_SDK_SECRET=""

# Zoom Server-to-Server OAuth app (for API calls / webhooks)
ZOOM_API_KEY=""
ZOOM_API_SECRET=""
ZOOM_WEBHOOK_SECRET_TOKEN=""

# SMTP (for sending meeting invite emails)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""

# Public URL of this deployment, used to build invite/recording links
NEXT_PUBLIC_APP_URL=""

# Postgres connection string (Railway's Postgres plugin provides this automatically
# as ${{Postgres.DATABASE_URL}})
DATABASE_URL=""

# UploadThing (recording storage)
UPLOADTHING_TOKEN=""

# Admin auth
ADMIN_JWT_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
